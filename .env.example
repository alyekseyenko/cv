# Path to job hunter master CV (Windows default below)
# CV_SOURCE=C:\Users\habit\Desktop\linked - Cópia (4) - Cópia\backend\user_cv.json
# CV_KNOWLEDGE_SOURCE=C:\Users\habit\Desktop\linked - Cópia (4) - Cópia\backend\knowledge_base.json

# Use neural-backend merge when Docker is up (watch-cv enables this by default)
# CV_NEURAL_URL=http://localhost:3004/api/cv/neural
# CV_USE_NEURAL=1

# Auto git commit + push for Vercel rebuild (set CV_AUTO_PUSH=0 to only write cv.generated.json)
# CV_AUTO_PUSH=1
# CV_AUTO_COMMIT=1
# CV_GIT_BRANCH=main

# Optional: Vercel Deploy Hook (Settings → Git → Deploy Hooks) if you do not rely on git push
# VERCEL_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/...
